# ------------------------------------------------------------------
# ブリッジサーバの設定。このファイルを .env にコピーして使う。
# （このプロジェクトは .env を自動で読み込まないので、
#   `set -a && source .env && set +a && npm start` のように読み込むか、
#   systemd の EnvironmentFile などで渡す）
# ------------------------------------------------------------------

# --- サーバ ---
HOST=0.0.0.0
PORT=8080
# 設定するとAPIに X-Access-Token ヘッダが必須になる。
# カメラのアクセスポイントは無防備な場合があるので、屋外運用では必ず設定する。
# スマホからは http://<サーバIP>:8080/?token=<値> で開けば自動保存される。
ACCESS_TOKEN=

# --- Claude ---
# 未設定なら自動的にルールベース（オフライン）で動作する。
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# low / medium / high / xhigh / max。屋外での応答速度を優先するなら low。
AI_EFFORT=medium
AI_TIMEOUT_MS=45000
# 強制的にルールベースだけを使う
AI_OFFLINE=false

# --- カメラ ---
# mock       : 実機なしで全機能を試す（既定）
# gphoto2    : USB接続（推奨）。実機が申告した設定だけを使うので推測が入らない
# ptpip      : Wi-Fi 経由（PTP/IP）。接続手順が未完成のため現状は動かない
# sdk-bridge : 公式 Camera Remote SDK をラップした別プロセスへ委譲（Windows向け）
CAMERA_TRANSPORT=mock

# --- USB接続 (CAMERA_TRANSPORT=gphoto2) ---
GPHOTO2_BINARY=gphoto2
# `gphoto2 --auto-detect` の Port 列の値。カメラを複数繋ぐ場合のみ指定する。
GPHOTO2_PORT=
# 実機から解決したマッピングの保存先。`npm run probe` が書き出す。
GPHOTO2_MAPPING=./config/gphoto2-mapping.json
# 保存済みマッピングを無視して毎回実機から解決し直す（設定を変えた直後の検証用）
GPHOTO2_RESCAN=false
GPHOTO2_TIMEOUT_MS=20000

# --- Wi-Fi接続 (CAMERA_TRANSPORT=ptpip) ---
CAMERA_HOST=192.168.0.1
CAMERA_PORT=55740
CAMERA_CLIENT_NAME=X100VI-AI-Assistant
# 実際には送信せず、送るはずのPTPフレームをログに出すだけ
CAMERA_DRY_RUN=false
# 実機未検証のプロパティコードも送信する（検証が済むまでは false 推奨）
ALLOW_UNVERIFIED_PROPS=false
PROPERTY_OVERRIDES=./config/fuji-properties.json
SDK_BRIDGE_URL=http://127.0.0.1:8787

# --- 動作 ---
# POST /api/auto（提案をそのまま自動適用）を有効にするか
ALLOW_AUTO_APPLY=true
